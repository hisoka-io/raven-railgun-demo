# Copy to .env.local and fill in. Vite reads VITE_* keys at build and dev time.
# Restart the dev server after changing any key here.

# Raven PIR backend bearer token (required; at least 16 chars). Existing PIR demos.
VITE_RAVEN_BEARER=

# Optional Raven overrides (defaults in src/lib/config.ts).
# VITE_RAVEN_URL=https://raven.hisoka.io
# VITE_RAVEN_TARGET=https://raven.hisoka.io
# VITE_ETH_RPC_URL=https://ethereum.publicnode.com
# VITE_PPOI_PUBLIC_URL=https://poi.us.proxy.railwayapi.xyz

# Transport-layer leak demos.
# Subsquid endpoint the Railgun wallet queries (subsquid-client/src/networks.ts:4, ETHEREUM_URL).
# VITE_SUBSQUID_URL=https://rail-squid.squids.live/squid-railgun-ethereum-v2/graphql

# IPFS gateway the Railgun wallet fetches circuit artifacts from
# (wallet/src/services/artifacts/artifact-util.ts:7, ipfs-artifact-fetcher/src/definitions.ts:5).
# VITE_IPFS_GATEWAY=https://ipfs-lb.com
